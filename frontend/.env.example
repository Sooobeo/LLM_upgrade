# Vercel frontend environment variables.
# Set these on the Vercel project whose root directory is `frontend`.

# Supabase project URL used only by the browser Supabase Auth client.
# Example: https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://alrazxpdcagyapidcuyf.supabase.co

# Supabase anon/public key used only by the browser Supabase Auth client.
# Never put the Supabase service-role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFscmF6eHBkY2FneWFwaWRjdXlmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjIwNzY2OTUsImV4cCI6MjA3NzQzNjY5NX0.K8AjXZmR_b1PuVayCgTn2cj8OUNMO0TG5j5QM9Qd35o

# FastAPI backend URL used by frontend fetch calls.
# This is not the Supabase URL. Do not add a trailing slash.
# Example: https://llm-upgrade-api.example.com
NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.example.com

# UI/request model name only. The Gemini API key belongs on the backend.
NEXT_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
