NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Optional alias supported by the current frontend:
# NEXT_PUBLIC_BACKEND_API_BASE_URL=http://127.0.0.1:8000

# Optional model shown when the primary model is unavailable
NEXT_PUBLIC_FALLBACK_MODEL=llama3.1:8b
# Optional display override. The API key belongs only in the backend .env.
NEXT_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
