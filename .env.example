# Required: Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required only for admin user lookup/workspace member features
SUPABASE_SERVICE_ROLE_KEY=

# Application
APP_ENV=local
OPENAPI_SERVER_URL=http://127.0.0.1:8000
# Leave empty for a host-only cookie in local development.
COOKIE_DOMAIN=
# In production set APP_ENV=prod and replace these with exact public values.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_REQUEST_BODY_BYTES=1048576
AUTH_RATE_LIMIT_PER_MINUTE=20
LLM_RATE_LIMIT_PER_MINUTE=30
ENABLE_PRODUCTION_API_DOCS=false

# LLM primary provider
LLM_PRIMARY_BASE_URL=https://llm.ycc.club
LLM_PRIMARY_PATH=/api/generate
LLM_MODEL=gemma3:270m
LLM_MODE=generate
LLM_TLS_VERIFY=true
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=120
LLM_MAX_RETRIES=2

# Google Gemini (server only; never expose this key as NEXT_PUBLIC_*)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_2_5_COMPAT_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECS=120


# Optional fallback (for example, local Ollama)
LLM_FALLBACK_BASE_URL=http://127.0.0.1:11434
LLM_FALLBACK_PATH=/api/chat
LLM_FALLBACK_KIND=ollama
LLM_FALLBACK_MODEL=llama3.1:8b
