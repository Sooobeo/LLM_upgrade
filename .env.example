# Backend only. Never copy server secrets into NEXT_PUBLIC_* variables.

# Required: Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Required for workspace member lookup by email
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production application
APP_ENV=prod
OPENAPI_SERVER_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com
# Use .example.com only when both services use subdomains of that domain.
# Otherwise leave empty for a backend host-only cookie.
COOKIE_DOMAIN=
MAX_REQUEST_BODY_BYTES=1048576
AUTH_RATE_LIMIT_PER_MINUTE=20
LLM_RATE_LIMIT_PER_MINUTE=30
ENABLE_PRODUCTION_API_DOCS=false

# Primary LLM provider
LLM_PRIMARY_BASE_URL=https://llm.ycc.club
LLM_PRIMARY_PATH=/api/generate
LLM_MODEL=gemma3:270m
LLM_MODE=generate
LLM_TLS_VERIFY=true
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=120
LLM_MAX_RETRIES=2

# Google Gemini (server only)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# The backend sends this ID when GEMINI_MODEL is gemini-2.5-flash.
GEMINI_2_5_COMPAT_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECS=120

# Optional fallback LLM
# LLM_FALLBACK_BASE_URL=https://fallback-llm.example.com
# LLM_FALLBACK_PATH=/api/chat
# LLM_FALLBACK_KIND=ollama
# LLM_FALLBACK_MODEL=llama3.1:8b
